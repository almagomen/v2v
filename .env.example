# Copy to .env and fill in your values. In Colab use Secrets (panel left).

# Google Gemini API (translation, title generation)
GOOGLE_API_KEY=

# Fish Audio API (TTS s2.1-pro-free / voice cloning)
FISH_API_KEY=

# Optional: automatic emotion tagging with Fish Audio (/enhance/text)
# 1 = add [emotion], [emphasis] and pause tags before TTS; 0 = disabled
V2V_FISH_AUTO_EMOTIONS=0
# Model used by /enhance/text (s2.1-pro or s2-pro)
V2V_FISH_ENHANCE_VERSION=s2.1-pro

# Optional: mount Google Drive in Colab (true/false)
DRIVE_MOUNT=false
