# V2V Professional Environment Variables

# App
APP_NAME=V2V Professional
DEBUG=true

# Database
DATABASE_URL=sqlite:///./v2v.db

# Directories
V2V_BASE_DIR=./data

# API Keys
LMNT_API_KEY=your_lmnt_api_key_here
LMNT_AUTH0_COOKIE=your_auth0_cookie_here
MIXPANEL_COOKIE=your_mixpanel_cookie_here
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace (for pyannote)
HF_TOKEN=your_huggingface_token_here

# Device (cuda or cpu)
DEVICE=cuda
