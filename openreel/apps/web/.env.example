# URL base del backend v2v API.
# Vacío = mismo origen (cuando OpenReel se sirve desde el mismo servidor que la API).
# Para desarrollo local con API en puerto 8000:
# VITE_V2V_API_URL=http://localhost:8000

# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
